{
  "name": "imghacks",
  "version": "1.0.0",
  "description": "API asincrona de generacion de imagenes (Google Flow + Perchance)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "build": "node scripts/build.js",
    "keys": "node --env-file-if-exists=.env scripts/keys.js"
  },
  "dependencies": {
    "@fastify/static": "^8.1.0",
    "fastify": "^5.2.0",
    "puppeteer-core": "^24.2.0",
    "undici": "^7.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
