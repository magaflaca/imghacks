PORT=8796
HOST=127.0.0.1
PUBLIC_URL=https://img.hacks.win
DATA_DIR=/opt/imghacks/data
PROVIDERS=flow,hacks

IMAGE_TTL_MIN=30
JOB_TTL_MIN=30

FLOW_BIN=/home/gflow/.local/bin/gflow
FLOW_CONCURRENCY=1
FLOW_TIMEOUT_MS=300000

HACKS_WORKERS=2
HACKS_BROWSER=/usr/bin/google-chrome
HACKS_TIMEOUT_MS=150000
HACKS_LOAD_TIMEOUT_MS=45000
HACKS_IDLE_MS=180000
HACKS_ATTEMPTS=4
HACKS_DIRECT=true
HACKS_PROXY_SEED=
PROXY_TARGET=12
PROXY_MAX_FAILS=3
PROXY_REFRESH_MS=600000

WEB_ACTIVE_JOBS=2
WEB_FLOW_PER_HOUR=12
WEB_HACKS_PER_HOUR=80
API_ACTIVE_JOBS=8
